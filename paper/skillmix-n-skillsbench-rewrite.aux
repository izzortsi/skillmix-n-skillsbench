\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-skill procedural-$\Delta $ at v2.0 ($n{=}5$ per skill, 40 skills). 11 skills lift on \textsc  {curated}\xspace  ; 25 are flat (mostly because \textsc  {baseline}\xspace  {} is already at ceiling); 4 regress. The lift cluster concentrates on interpretive and spatial-social skills; the regression cluster on deductive-logic skills where the model has ceiling competence on \textsc  {baseline}\xspace  .}}{21}{figure.caption.8}\protected@file@percent }
\newlabel{fig:per-skill}{{4}{21}{Per-skill procedural-$\Delta $ at v2.0 ($n{=}5$ per skill, 40 skills). 11 skills lift on \CU ; 25 are flat (mostly because \BL {} is already at ceiling); 4 regress. The lift cluster concentrates on interpretive and spatial-social skills; the regression cluster on deductive-logic skills where the model has ceiling competence on \BL }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: bootstrap distributions of the procedural-$\Delta $ for v1.9 and v2.0 (10{,}000 resamples of paired \texttt  {task\_uid}s). Both distributions sit above zero (the dashed line) but overlap substantially. Right: distribution of the difference $\Delta _{\mathrm  {v1.9}} - \Delta _{\mathrm  {v2.0}}$. The 95\% CI shaded in red includes zero, and the one-sided test for the saturation hypothesis returns $p{=}0.225$. Direction is consistent with saturation; magnitude is not statistically distinguishable from noise.}}{22}{figure.caption.10}\protected@file@percent }
\newlabel{fig:bootstrap}{{5}{22}{Left: bootstrap distributions of the procedural-$\Delta $ for v1.9 and v2.0 (10{,}000 resamples of paired \texttt {task\_uid}s). Both distributions sit above zero (the dashed line) but overlap substantially. Right: distribution of the difference $\Delta _{\mathrm {v1.9}} - \Delta _{\mathrm {v2.0}}$. The 95\% CI shaded in red includes zero, and the one-sided test for the saturation hypothesis returns $p{=}0.225$. Direction is consistent with saturation; magnitude is not statistically distinguishable from noise}{figure.caption.10}{}}

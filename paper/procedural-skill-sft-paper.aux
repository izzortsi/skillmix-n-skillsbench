\newlabel{sec:cross-family}{{5}{7}{Cross-Family Judge Validation}{section.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Cross-family judge cross-validation across all seven configurations / 2800 paired episodes. Per-episode agreement ranges from $93.25\%$ (pre-SFT 4B) to $100.00\%$ (v1.9, 400/400 identical verdicts). Cohen's $\kappa $ ranges from $0.754$ to $1.000$. Pre-SFT 0.8B HF agreement is $98.50\%$ ($\kappa = 0.968$). Headline $\Delta $ shifts $\leq 0.035$\,pp on every dataset; both judges agree on the direction of every per-student finding, including the W-shape's two negative-Δ pockets at 0.8B and 4B.}}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:cross-family}{{4}{7}{Cross-family judge cross-validation across all seven configurations / 2800 paired episodes. Per-episode agreement ranges from $93.25\%$ (pre-SFT 4B) to $100.00\%$ (v1.9, 400/400 identical verdicts). Cohen's $\kappa $ ranges from $0.754$ to $1.000$. Pre-SFT 0.8B HF agreement is $98.50\%$ ($\kappa = 0.968$). Headline $\Delta $ shifts $\leq 0.035$\,pp on every dataset; both judges agree on the direction of every per-student finding, including the W-shape's two negative-Δ pockets at 0.8B and 4B}{table.caption.7}{}}
\@writefile{toc}{\contentsline {paragraph}{What this validation does not close.}{7}{table.caption.7}\protected@file@percent }

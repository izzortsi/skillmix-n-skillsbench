\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-skill procedural-Δ at v2.0 ($n{=}5$ per skill, 40 skills). 11 skills lift on \textsc  {curated}\xspace  ; 25 are flat (mostly because \textsc  {baseline}\xspace  {} is already at ceiling); 4 regress. The lift cluster concentrates on interpretive and spatial-social skills; the regression cluster on deductive-logic skills where the model has ceiling competence on \textsc  {baseline}\xspace  .}}{15}{figure.caption.4}\protected@file@percent }
\newlabel{fig:per-skill}{{2}{15}{Per-skill procedural-Δ at v2.0 ($n{=}5$ per skill, 40 skills). 11 skills lift on \CU ; 25 are flat (mostly because \BL {} is already at ceiling); 4 regress. The lift cluster concentrates on interpretive and spatial-social skills; the regression cluster on deductive-logic skills where the model has ceiling competence on \BL }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-skill procedural-Δ at v2.0 versus per-skill baseline pass rate (LLM-only judging, $n{=}5$ tasks per skill, 40 skills). Spearman $\rho = -0.227$. Skills where the base is already at ceiling on baseline cannot benefit from procedure injection (flat cluster); skills with lower baseline have the most Δ headroom (lift cluster). The negative slope is qualitative evidence that SFT's distinctive value is in scaffolding skills the base struggles with, not in lifting already-saturated skills.}}{16}{figure.caption.5}\protected@file@percent }
\newlabel{fig:per-skill-bl-vs-delta}{{3}{16}{Per-skill procedural-Δ at v2.0 versus per-skill baseline pass rate (LLM-only judging, $n{=}5$ tasks per skill, 40 skills). Spearman $\rho = -0.227$. Skills where the base is already at ceiling on baseline cannot benefit from procedure injection (flat cluster); skills with lower baseline have the most Δ headroom (lift cluster). The negative slope is qualitative evidence that SFT's distinctive value is in scaffolding skills the base struggles with, not in lifting already-saturated skills}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces v1.9 lift over pre-SFT 0.8B decomposed into base-model scaling (gray; measured between the two pre-SFT controls) and SFT contribution at 2B (green; the residual from pre-SFT 2B to v1.9). The SFT contribution is $+6.5$\,pp on \textsc  {baseline}\xspace  {} and $+11.5$\,pp on \textsc  {curated}\xspace  .}}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:attribution}{{4}{16}{v1.9 lift over pre-SFT 0.8B decomposed into base-model scaling (gray; measured between the two pre-SFT controls) and SFT contribution at 2B (green; the residual from pre-SFT 2B to v1.9). The SFT contribution is $+6.5$\,pp on \BL {} and $+11.5$\,pp on \CU }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: bootstrap distributions of the procedural-Δ for v1.9 and v2.0 (10{,}000 resamples of paired \texttt  {task\_uid}s). Both distributions sit above zero (dashed line) but overlap substantially. Right: distribution of $\Delta _{\mathrm  {v1.9}} - \Delta _{\mathrm  {v2.0}}$; the 95\% CI (red shading) includes zero, and the one-sided test for the saturation hypothesis returns $p{=}0.225$. Direction consistent with saturation; magnitude not statistically distinguishable from noise.}}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:bootstrap}{{5}{17}{Left: bootstrap distributions of the procedural-Δ for v1.9 and v2.0 (10{,}000 resamples of paired \texttt {task\_uid}s). Both distributions sit above zero (dashed line) but overlap substantially. Right: distribution of $\Delta _{\mathrm {v1.9}} - \Delta _{\mathrm {v2.0}}$; the 95\% CI (red shading) includes zero, and the one-sided test for the saturation hypothesis returns $p{=}0.225$. Direction consistent with saturation; magnitude not statistically distinguishable from noise}{figure.caption.12}{}}

\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces SFT contribution across all three model sizes under matched HF + LLM-only scoring. The Δ-lift attributable to SFT is in a tight $4$\,pp band ($+0.040$ to $+0.075$) across an order-of-magnitude in base-model capacity; the absolute \textsc  {curated}\xspace  {} contribution is in a similar band ($+0.100$ to $+0.145$). The variation in post-SFT Δ across sizes is dominated by the pre-SFT base trajectory, which is W-shaped (negative at 0.8B and 4B, positive at 2B and frontier-class haiku-4-5; cf.\ Table~\ref {tab:llm-only}).}}{8}{table.caption.6}\protected@file@percent }
\newlabel{tab:sft-contribution}{{4}{8}{SFT contribution across all three model sizes under matched HF + LLM-only scoring. The Δ-lift attributable to SFT is in a tight $4$\,pp band ($+0.040$ to $+0.075$) across an order-of-magnitude in base-model capacity; the absolute \CU {} contribution is in a similar band ($+0.100$ to $+0.145$). The variation in post-SFT Δ across sizes is dominated by the pre-SFT base trajectory, which is W-shaped (negative at 0.8B and 4B, positive at 2B and frontier-class haiku-4-5; cf.\ Table~\ref {tab:llm-only})}{table.caption.6}{}}
\@writefile{toc}{\contentsline {paragraph}{The bench saturation diagnosis splits in two.}{8}{table.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Why does pre-SFT base Δ trace a W-shape?}{8}{table.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Per-skill structure.}{8}{table.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Per-skill BL-vs-Δ correlation: regime-asymmetric story holds at the skill level (qualitatively).}{9}{table.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-skill procedural-Δ at v2.0 versus per-skill baseline pass rate (LLM-only judging, $n{=}5$ tasks per skill, 40 skills). Spearman $\rho = -0.227$. Skills where the base is already at ceiling on baseline cannot benefit from procedure injection (flat cluster, BL $\approx 1.0$); skills with lower baseline have the most Δ headroom (lift cluster, mean BL $\approx 0.71$). One regression-cluster skill (\texttt  {equivocation}) has BL $1.0$ and CU $0.8$, fitting the same pattern: the procedure adds friction on a skill the base could already one-shot. The negative slope is qualitative evidence that SFT's distinctive value is in scaffolding skills the base struggles with, not in lifting already-saturated skills.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:per-skill-bl-vs-delta}{{3}{9}{Per-skill procedural-Δ at v2.0 versus per-skill baseline pass rate (LLM-only judging, $n{=}5$ tasks per skill, 40 skills). Spearman $\rho = -0.227$. Skills where the base is already at ceiling on baseline cannot benefit from procedure injection (flat cluster, BL $\approx 1.0$); skills with lower baseline have the most Δ headroom (lift cluster, mean BL $\approx 0.71$). One regression-cluster skill (\texttt {equivocation}) has BL $1.0$ and CU $0.8$, fitting the same pattern: the procedure adds friction on a skill the base could already one-shot. The negative slope is qualitative evidence that SFT's distinctive value is in scaffolding skills the base struggles with, not in lifting already-saturated skills}{figure.caption.7}{}}
